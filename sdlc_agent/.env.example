# Copy to .env and fill in your real values. NEVER commit .env.
# This .example file is a TEMPLATE only — keep placeholder values here.

# ---------- Jira (optional — task board sync) ----------
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-workspace.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here
JIRA_PROJECT_KEY=SCRUM

# ---------- Anthropic (optional — only if config.py routes a stage to claude-*) ----------
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxx

# ---------- Flutter project output ----------
# FLUTTER_OUTPUT_DIR=~/Documents/claude ai
# FLUTTER_ORG=com.example
# FLUTTER_BUILD_TARGETS=apk,ios

# ---------- Pipeline tuning ----------
# MAX_REWORK=5
